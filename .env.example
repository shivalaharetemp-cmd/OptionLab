# ---- Upstox ---------------------------------------------------------------
# Generate at https://account.upstox.com/developer/apps#analytics  (read-only, 1-year validity)
UPSTOX_ANALYTICS_TOKEN=

# live = real Upstox data (needs token) | demo = built-in market simulator (no token, any time of day)
# If unset: live when a token is present, otherwise demo.
OPTIONLAB_MODE=

# Underlyings to scan for signals (NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY, SENSEX)
WATCHLIST=NIFTY,BANKNIFTY

# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Tuning (all optional) -------------------------------------------------
CHAIN_POLL_SECONDS=10
ATM_WINDOW_STRIKES=8
DEMO_SPEED=30
# Only set to 1 if your server IP is whitelisted in the Upstox console (unlocks User/Portfolio/Orders READ endpoints in the Explorer)
UPSTOX_STATIC_IP_WHITELISTED=0
